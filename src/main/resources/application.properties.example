# Copy this file to application.properties and replace the placeholder values.
spring.application.name=Dex
server.port=8080

spring.datasource.url=jdbc:postgresql://localhost:5432/dex_db
spring.datasource.username=postgres
spring.datasource.password=replace-with-your-local-password

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
